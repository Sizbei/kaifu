# Japan-hosted inference. All Japanese generation and register work.
# The gateway also exposes non-Japan-hosted models (glm-*, qwen*); SHISA_MODEL
# is allowlisted to shisa-ai/* in src/lib/shisa.ts so those cannot be selected.
SHISA_BASE_URL=https://api.shisa.ai/openai/v1
SHISA_API_KEY=
SHISA_MODEL=shisa-ai/shisa-v2.1-llama3.3-70b

# OpenAI does vision only: OCR + classification + field extraction, returned as
# structured JSON. It never generates Japanese — Shisa above does all of that.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5

# Qdrant vector store for JUDGE retrieval (embeddings: OpenAI text-embedding-3-small,
# reusing OPENAI_API_KEY above — vectors only, never Japanese prose). Optional: if
# QDRANT_URL is unset, Qdrant is unreachable, or OPENAI_API_KEY is missing, JUDGE
# falls back to keyword-hint routing with one logged warning.
# Local: `qdrant` on the default port; then `pnpm index:groundtruth`.
# QDRANT_URL=http://localhost:6333
# Only needed for Qdrant Cloud; leave blank for a local instance.
QDRANT_API_KEY=

# Corpus graph (Neo4j), optional. Populated only for opt-in decodes
# ({ contribute: true }) and stores no document text — see docs/ARCHITECTURE.md.
# Leave NEO4J_URI unset to disable; every graph call becomes a logged no-op.
# NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
