# Japan-hosted inference. All Japanese generation and register work.
# The gateway also exposes non-Japan-hosted models (glm-*, qwen*); SHISA_MODEL
# is allowlisted to shisa-ai/* in src/lib/shisa.ts so those cannot be selected.
SHISA_BASE_URL=https://api.shisa.ai/openai/v1
SHISA_API_KEY=
SHISA_MODEL=shisa-ai/shisa-v2.1-llama3.3-70b

# OCR + classification + field extraction only. Never generates Japanese.
ANTHROPIC_API_KEY=
